# Copiar a .env y ajustar. Todas las variables llevan el prefijo RATES_
RATES_DB_PATH=data/rates.db
RATES_TZ_OFFSET_HOURS=-4
RATES_COLLECTOR_ENABLED=true
RATES_COLLECTOR_INTERVAL_SECONDS=300
# JSON list
RATES_COLLECTOR_SOURCES=["binance_p2p","yadio","bcv","paralelo"]
RATES_BINANCE_ROWS=10
# JSON list de orígenes permitidos; vacío = sin CORS (mismo origen)
RATES_CORS_ORIGINS=[]
# Obligatoria para POST /import y POST /collect (header X-API-Key); vacía = esos endpoints responden 503
RATES_API_KEY=
